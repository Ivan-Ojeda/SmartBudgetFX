<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane prefHeight="800.0" prefWidth="1100.0" stylesheets="@style.css" fx:controller="application.DashboardController" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
   
   <BorderPane fx:id="dashboardView" visible="false">
      <left>
         <VBox prefWidth="280.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding><Insets bottom="30.0" left="25.0" right="25.0" top="40.0" /></padding>
            <children>
               <ImageView fitWidth="220.0" preserveRatio="true">
                  <image><Image url="@logo.jpg" /></image>
                  <VBox.margin><Insets bottom="40.0" /></VBox.margin>
               </ImageView>
               
               <VBox spacing="10.0" styleClass="nav-menu">
                  <children>
                     <Button maxWidth="Infinity" onAction="#mostrarInicio" styleClass="nav-btn" text="Inicio" />
                     <Button maxWidth="Infinity" onAction="#mostrarMovimientos" styleClass="nav-btn" text="Movimientos" />
                     <Button maxWidth="Infinity" onAction="#mostrarCategorias" styleClass="nav-btn" text="Categorías" />
                     <Button maxWidth="Infinity" onAction="#mostrarAhorro" styleClass="nav-btn" text="Ahorro" />
                     <Button maxWidth="Infinity" onAction="#mostrarGraficos" styleClass="nav-btn" text="Gráficos" />
                     <Button fx:id="btnMiembros" maxWidth="Infinity" onAction="#mostrarMiembros" styleClass="nav-btn" text="Miembros Casa" />
                     <Button maxWidth="Infinity" onAction="#mostrarConfig" styleClass="nav-btn" text="Configuración" />
                  </children>
               </VBox>
            </children>
         </VBox>
      </left>
      
      <center>
         <VBox style="-fx-background-color: #EDE8D0;">
            <children>
               <HBox alignment="CENTER_LEFT" styleClass="header">
                  <padding><Insets bottom="20.0" left="40.0" right="40.0" top="40.0" /></padding>
                  <children>
                     <Label fx:id="lblTitulo" styleClass="header-title" text="Resumen General" />
                     <Region HBox.hgrow="ALWAYS" />
                     <HBox alignment="CENTER" spacing="15.0" styleClass="user-profile">
                        <children>
                           <Label fx:id="displayUser" styleClass="user-name" text="Hola, Usuario" />
                           <Circle fill="#C6A664" radius="22.0" stroke="WHITE" strokeWidth="2.0" />
                        </children>
                     </HBox>
                  </children>
               </HBox>
               
               <StackPane VBox.vgrow="ALWAYS">
                  <padding><Insets bottom="40.0" left="40.0" right="40.0" top="20.0" /></padding>
                  
                  <ScrollPane fx:id="secResumen" fitToWidth="true" styleClass="main-content" visible="true">
                     <content>
                        <VBox spacing="30.0">
                           <children>
                              <HBox spacing="25.0">
                                 <children>
                                    <VBox styleClass="summary-card, card-balance" HBox.hgrow="ALWAYS">
                                       <Label styleClass="card-subtitle" text="Balance Total Corriente" />
                                       <Label styleClass="card-title" text="2.850,40 €" />
                                    </VBox>
                                    <VBox styleClass="summary-card, card-gastos" HBox.hgrow="ALWAYS">
                                       <Label styleClass="card-subtitle" text="Gastos del Mes" />
                                       <Label styleClass="card-title" text="1.420,15 €" />
                                    </VBox>
                                    <VBox styleClass="summary-card, card-proximo" HBox.hgrow="ALWAYS">
                                       <Label styleClass="card-subtitle" text="Resumen de Ahorro" />
                                       <ComboBox maxWidth="Infinity" promptText="Fondo Emergencia: 12.400€ / 20.000€" style="-fx-background-color: white; -fx-margin-top: 10px;" />
                                    </VBox>
                                 </children>
                              </HBox>
                              <Label styleClass="section-subtitle" text="Últimos Movimientos" />
                              <TableView prefHeight="350.0">
                                <columns>
                                  <TableColumn prefWidth="120.0" text="Fecha" reorderable="false" />
                                  <TableColumn prefWidth="250.0" text="Concepto" reorderable="false" />
                                  <TableColumn prefWidth="150.0" text="Categoría" reorderable="false" />
                                  <TableColumn prefWidth="150.0" text="Usuario" reorderable="false" />
                                  <TableColumn prefWidth="120.0" text="Monto" reorderable="false" />
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                              </TableView>
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>

                  <ScrollPane fx:id="secMovimientos" fitToWidth="true" styleClass="main-content" visible="false">
                     <content>
                        <VBox spacing="20.0">
                           <children>
                              <HBox alignment="CENTER_RIGHT" spacing="15.0">
                                 <children>
                                    <Button styleClass="btn-primary" style="-fx-background-color: #C6A664;" text="Filtros ▼" />
                                    <Button styleClass="btn-primary" text="Añadir Movimiento" />
                                 </children>
                              </HBox>
                              <TableView prefHeight="400.0">
                                <columns>
                                  <TableColumn text="Día" reorderable="false" />
                                  <TableColumn text="Fecha" reorderable="false" />
                                  <TableColumn text="Categoría" reorderable="false" />
                                  <TableColumn prefWidth="200.0" text="Descripción" reorderable="false" />
                                  <TableColumn text="Usuario" reorderable="false" />
                                  <TableColumn text="Monto" reorderable="false" />
                                  <TableColumn text="Acciones" reorderable="false" />
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                              </TableView>
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>

                  <ScrollPane fx:id="secCategorias" fitToWidth="true" styleClass="main-content" visible="false">
                     <content>
                        <VBox spacing="20.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="15.0">
                                 <children>
                                    <Label text="Administre las categorías para clasificar sus movimientos." HBox.hgrow="ALWAYS" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button styleClass="btn-primary" text="Nueva Categoría" />
                                 </children>
                              </HBox>
                              <TableView prefHeight="400.0">
                                <columns>
                                  <TableColumn text="Nombre de Categoría" reorderable="false" />
                                  <TableColumn text="Tipo Deducido" reorderable="false" />
                                  <TableColumn text="Presupuesto / Límite Mensual" reorderable="false" />
                                  <TableColumn text="Acciones" reorderable="false" />
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                              </TableView>
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>

                  <ScrollPane fx:id="secAhorro" fitToWidth="true" styleClass="main-content" visible="false">
                     <content>
                        <VBox spacing="25.0">
                           <VBox alignment="CENTER" style="-fx-background-color: #8E7644; -fx-background-radius: 16; -fx-padding: 30;">
                              <children>
                                 <Label style="-fx-text-fill: #EDE8D0; -fx-font-weight: bold;" text="Saldo Total en Cuenta de Ahorro" />
                                 <Label style="-fx-text-fill: #EDE8D0; -fx-font-size: 32px; -fx-font-weight: bold;" text="12.400,00 €" />
                              </children>
                           </VBox>
                           <VBox styleClass="savings-card">
                              <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
                              <HBox alignment="CENTER_LEFT">
                                 <VBox spacing="10.0">
                                    <Label styleClass="section-subtitle" text="Objetivo Actual: Fondo de Emergencia" />
                                    <Button styleClass="btn-primary" text="Añadir Objetivo" />
                                 </VBox>
                                 <Region HBox.hgrow="ALWAYS" />
                                 <Label styleClass="percentage-badge" text="62%" />
                              </HBox>
                              <ProgressBar maxWidth="Infinity" progress="0.62" styleClass="progress-bar-ahorro">
                                 <VBox.margin><Insets bottom="10.0" top="20.0" /></VBox.margin>
                              </ProgressBar>
                              <HBox>
                                 <Label style="-fx-font-weight: bold;" text="Alcanzado: 12.400,00 €" />
                                 <Region HBox.hgrow="ALWAYS" />
                                 <Label text="Meta: 20.000 €" />
                              </HBox>
                           </VBox>
                        </VBox>
                     </content>
                  </ScrollPane>

                  <ScrollPane fx:id="secGraficos" fitToWidth="true" styleClass="main-content" visible="false">
                     <content>
                        <VBox alignment="CENTER" styleClass="savings-card">
                           <Label text="Zona de Gráficos" />
                        </VBox>
                     </content>
                  </ScrollPane>

                  <ScrollPane fx:id="secMiembros" fitToWidth="true" styleClass="main-content" visible="false">
                     <content>
                        <VBox spacing="20.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="15.0">
                                 <children>
                                    <Label text="Gestione los perfiles de la casa. Defina quién puede ver o registrar movimientos." HBox.hgrow="ALWAYS" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button styleClass="btn-primary" text="Invitar Familiar" />
                                 </children>
                              </HBox>
                              <TableView prefHeight="400.0">
                                <columns>
                                  <TableColumn text="Miembro" reorderable="false" />
                                  <TableColumn text="Rol" reorderable="false" />
                                  <TableColumn text="Estado" reorderable="false" />
                                  <TableColumn text="Acciones" reorderable="false" />
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                              </TableView>
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>

                  <ScrollPane fx:id="secConfig" fitToWidth="true" styleClass="main-content" visible="false">
                     <content>
                        <VBox styleClass="savings-card">
                           <Label styleClass="section-subtitle" text="Ajustes de Plataforma" />
                           <Label text="Pantalla de ajustes pendiente de definición con el cliente para el siguiente Sprint." />
                        </VBox>
                     </content>
                  </ScrollPane>

               </StackPane>
            </children>
         </VBox>
      </center>
   </BorderPane>

   <StackPane fx:id="authView" style="-fx-background-color: #EDE8D0;">
      <children>
         <VBox alignment="CENTER" maxWidth="450.0" spacing="20.0" styleClass="auth-card">
            <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>
            <children>
               <ImageView fitWidth="250.0" preserveRatio="true">
                  <image><Image url="@logo.jpg" /></image>
                  <VBox.margin><Insets bottom="10.0" /></VBox.margin>
               </ImageView>
               
               <HBox alignment="CENTER" spacing="20.0">
                  <children>
                     <Label fx:id="tabLoginLabel" onMouseClicked="#mostrarFormLogin" style="-fx-text-fill: #4A4A4A; -fx-font-weight: bold; -fx-padding: 10; -fx-border-color: #C6A664; -fx-border-width: 0 0 2 0; -fx-cursor: hand;" text="Iniciar Sesión" HBox.hgrow="ALWAYS" />
                     <Label fx:id="tabRegisterLabel" onMouseClicked="#mostrarFormRegistro" style="-fx-text-fill: #888; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;" text="Registrarse" HBox.hgrow="ALWAYS" />
                  </children>
                  <VBox.margin><Insets bottom="10.0" /></VBox.margin>
               </HBox>
               
               <VBox fx:id="formLogin" spacing="15.0">
                  <VBox spacing="5.0">
                     <Label style="-fx-font-weight: bold;" text="Nombre de Usuario" />
                     <TextField promptText="Ej: Juan Pérez" styleClass="form-control" />
                  </VBox>
                  <VBox spacing="5.0">
                     <Label style="-fx-font-weight: bold;" text="Contraseña" />
                     <PasswordField promptText="••••••••" styleClass="form-control" />
                  </VBox>
                  <Button maxWidth="Infinity" onAction="#entrarDashboard" styleClass="btn-primary" text="Acceder al Dashboard">
                     <VBox.margin><Insets top="10.0" /></VBox.margin>
                  </Button>
               </VBox>
               
               <VBox fx:id="formRegister" managed="false" spacing="15.0" visible="false">
                  <VBox spacing="5.0">
                     <Label style="-fx-font-weight: bold;" text="Nombre Completo" />
                     <TextField promptText="Ej: María López" styleClass="form-control" />
                  </VBox>
                  <VBox spacing="5.0">
                     <Label style="-fx-font-weight: bold;" text="Contraseña" />
                     <PasswordField promptText="Crea una contraseña" styleClass="form-control" />
                  </VBox>
                  <Button maxWidth="Infinity" onAction="#entrarDashboard" styleClass="btn-primary" text="Crear Cuenta">
                     <VBox.margin><Insets top="10.0" /></VBox.margin>
                  </Button>
               </VBox>

               <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #F9F8F3; -fx-padding: 10; -fx-border-color: #ddd; -fx-border-radius: 8;">
                  <children>
                     <CheckBox fx:id="checkAdmin" mnemonicParsing="false" text="Simular acceso como Administrador" />
                  </children>
               </HBox>
            </children>
         </VBox>
      </children>
   </StackPane>
</StackPane>