<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@styleAhorroVista.css"
      fx:controller="application.AhorroController"
      spacing="15"
      alignment="CENTER"
      styleClass="main-container"> <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="Nuevo Objetivo" styleClass="titulo-secundario" />
    
    <VBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Nombre del objetivo" styleClass="label-formulario"/>
        <TextField fx:id="txtNombreCategoria"
                   promptText="Ej. Viaje a Japón" 
                   styleClass="input-field"/>
    </VBox>

    <VBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Cantidad a ahorrar (€)" styleClass="label-formulario"/>
        <TextField fx:id="txtCantidadAhorro"
                   promptText="0.00" 
                   styleClass="input-field"/>
    </VBox>

    <VBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Frecuencia de aportación" styleClass="label-formulario"/>
        <ComboBox fx:id="comboFrecuenciaPago"
                  promptText="Selecciona frecuencia" 
                  maxWidth="Infinity"
                  styleClass="combo-field"/>
    </VBox>

    <VBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Descripción (opcional)" styleClass="label-formulario"/>
        <TextField fx:id="txtDescripcionAhorro"
                   promptText="Añade un detalle..." 
                   styleClass="input-field"/>
    </VBox>

    <Region prefHeight="10" />

    <Button text="Guardar objetivo" 
            onAction="#anadirObjetivo" 
            maxWidth="Infinity"
            styleClass="btn-guardar" />

</VBox>